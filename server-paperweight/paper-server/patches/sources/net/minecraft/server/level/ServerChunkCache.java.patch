+    /**
+     * Returns an immutable snapshot of chunks currently loaded to FULL status.
+     * This method must be called from the level's server thread.
+     */
+    public List<ChunkPos> snapshotFullChunkPositions() {
+        if (Thread.currentThread() != this.mainThread) {
+            throw new IllegalStateException("Full chunk snapshots must be captured on the server thread");
+        }
+        return this.chunkMap.allChunksWithAtLeastStatus(ChunkStatus.FULL).map(ChunkHolder::getPos).toList();
+    }
