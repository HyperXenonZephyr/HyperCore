+package dev.hypercore.server.plugin;
+
+import java.util.List;
+import java.util.Objects;
+
+/** Context scoped to one plugin registration. */
+public final class PluginContext {
+    private final PluginRuntime runtime;
+    private final PluginDescriptor descriptor;
+
+    PluginContext(final PluginRuntime runtime, final PluginDescriptor descriptor) {
+        this.runtime = runtime;
+        this.descriptor = descriptor;
+    }
+
+    public PluginDescriptor descriptor() { return this.descriptor; }
+
+    public void registerCommand(final String label, final PluginRuntime.Command command) {
+        this.runtime.registerCommand(this.descriptor.id(), label, command);
+    }
+
+    public PluginRuntime.TaskHandle runTask(final Runnable action) {
+        return this.runtime.schedule(this.descriptor.id(), action);
+    }
+
+    public <E> PluginRuntime.Subscription registerListener(final Class<E> eventType, final PluginRuntime.EventListener<E> listener) {
+        return this.runtime.registerListener(this.descriptor.id(), eventType, listener);
+    }
+
+    public <E> PluginRuntime.Subscription registerListener(final Class<E> eventType, final EventPriority priority, final PluginRuntime.EventListener<E> listener) {
+        return this.runtime.registerListener(this.descriptor.id(), eventType, priority, listener);
+    }
+
+    /** Registers a permission default owned by this plugin; rolled back on failure or disable. */
+    public void registerPermission(final String node, final PermissionRegistry.Default def) {
+        this.runtime.registerPermission(this.descriptor.id(), node, def);
+    }
+
+    public boolean hasPermission(final String node, final boolean op) {
+        this.requireServerThread();
+        return this.runtime.permissions().check(node, op);
+    }
+
+    public PluginRuntime.TaskHandle runTaskLater(final Runnable action, final long delayTicks) {
+        return this.runtime.scheduleLater(this.descriptor.id(), action, delayTicks);
+    }
+
+    public PluginRuntime.TaskHandle runTaskTimer(final Runnable action, final long delayTicks, final long periodTicks) {
+        return this.runtime.scheduleTimer(this.descriptor.id(), action, delayTicks, periodTicks);
+    }
+
+    public List<String> plugins() { return this.runtime.pluginIds(); }
+
+    public void requireServerThread() { this.runtime.requireServerThread(); }
+}
