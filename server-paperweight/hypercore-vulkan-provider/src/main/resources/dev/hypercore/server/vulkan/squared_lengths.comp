#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer PositionsX { float values[]; } positionsX;
layout(set = 0, binding = 1, std430) readonly buffer PositionsY { float values[]; } positionsY;
layout(set = 0, binding = 2, std430) readonly buffer PositionsZ { float values[]; } positionsZ;
layout(set = 0, binding = 3, std430) writeonly buffer SquaredLengths { float values[]; } outputValues;

layout(push_constant) uniform Parameters {
    uint count;
} parameters;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.count) return;
    float x = positionsX.values[index];
    float y = positionsY.values[index];
    float z = positionsZ.values[index];
    outputValues.values[index] = x * x + y * y + z * z;
}
